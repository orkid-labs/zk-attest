{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on the first day of the month"
  ],
  "groupMinorUpdates": true,
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "@elizaos/core"
      ],
      "enabled": false
    }
  ]
}
